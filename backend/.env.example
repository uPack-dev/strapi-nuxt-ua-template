HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database. Local dev defaults to SQLite (needs the better-sqlite3 devDependency).
# Production images are pruned to prod deps only and ship mysql2 — set
# DATABASE_CLIENT=mysql explicitly there, or Strapi falls back to sqlite and
# crashes with "Cannot find module 'better-sqlite3'".
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# MySQL / PostgreSQL (uncomment and fill for non-SQLite environments):
# DATABASE_CLIENT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=app
# DATABASE_USERNAME=app
# DATABASE_PASSWORD=
# DATABASE_SSL=false
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
